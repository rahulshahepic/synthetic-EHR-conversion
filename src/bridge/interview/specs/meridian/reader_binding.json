{
 "canonical": {
  "AllergyIntolerance": {
   "fields": {
    "ALG_ID": "ALG_NO",
    "ALLERGEN": "ALLERGEN_TXT",
    "ENTERED_DT": {
     "date": "%m/%d/%Y",
     "field": "NOTED_DT"
    },
    "PAT_ID": "PERSON_NO",
    "REACTION": "REACTION_TXT",
    "SEVERITY": {
     "field": "SEVERITY",
     "map": {
      "MILD": "MILD",
      "MODERATE": "MOD",
      "SEVERE": "SEV"
     }
    }
   },
   "file": "ALLERGY",
   "key": "ALG_NO"
  },
  "Appointment": {
   "fields": {
    "APPT_DT": {
     "datetime": "%Y-%m-%d %H:%M",
     "field": "APPT_TS"
    },
    "APPT_ID": "APPT_NO",
    "DEPT_ID": "CLINIC_CD",
    "DURATION_MIN": "LEN_MIN",
    "PAT_ID": "PERSON_NO",
    "PROV_ID": "PROVIDER_ID",
    "REASON": "APPT_REASON",
    "STATUS": {
     "field": "APPT_STATUS",
     "map": {
      "ARR": "A",
      "CAN": "X",
      "CMP": "C",
      "NOS": "N",
      "SCH": "S"
     }
    }
   },
   "file": "APPT",
   "key": "APPT_NO"
  },
  "Condition": {
   "fields": {
    "CODE": {
     "field": "DX_CODE",
     "icd_decimal": {
      "icd9": "I9",
      "system_field": "CODE_SYS"
     }
    },
    "CODE_TYPE": {
     "field": "CODE_SYS",
     "map": {
      "I10": "10",
      "I9": "9"
     }
    },
    "DX_DESC": "DX_TEXT",
    "DX_ID": "PROB_NO",
    "ONSET_DT": {
     "date": "%m/%d/%Y",
     "field": "ONSET_DT"
    },
    "PAT_ID": "PERSON_NO",
    "RESOLVED_DT": {
     "date": "%m/%d/%Y",
     "field": "RESOLVE_DT"
    },
    "STATUS": "STATUS",
    "VISIT_ID": "VISIT_NO"
   },
   "file": "PROBLEM",
   "key": "PROB_NO"
  },
  "Coverage": {
   "fields": {
    "COB_ORDER": "PRIORITY",
    "EFF_DT": {
     "date": "%m/%d/%Y",
     "field": "EFF_DT"
    },
    "MEMBER_ID": "MEMBER_ID",
    "PAT_ID": "PERSON_NO",
    "PLAN_ID": "PLAN_CD",
    "REL_CODE": {
     "field": "REL_CD",
     "map": {
      "C": "19",
      "D": "19",
      "O": "G8",
      "P": "01",
      "S": "18"
     }
    },
    "TERM_DT": {
     "date": "%m/%d/%Y",
     "field": "END_DT"
    }
   },
   "file": "INSCOV",
   "key": "COV_NO"
  },
  "Encounter": {
   "exclude": {
    "STATUS": [
     "VOID"
    ]
   },
   "exclude_reason": {
    "VOID": "visit entered in error (guide \u00a74; Gary E000166)"
   },
   "exclude_unless": {
    "all": [
     {
      "in": [
       "ER"
      ],
      "value": {
       "field": "VISIT_TYPE",
       "upper": true
      }
     },
     {
      "blank": false,
      "value": {
       "field": "VISIT_NO",
       "lookup": {
        "file": "VITALS",
        "key": "VISIT_NO",
        "value": "VS_NO"
       }
      }
     }
    ]
   },
   "exclude_unless_annotate": {
    "field": "status",
    "klass": "inferred",
    "note": "VOID kept as a cancelled visit: ER VOID with triage vitals = left without being seen (spec rule from Denise Okafor, E000192/E000194)"
   },
   "fields": {
    "ADMIT_DT": {
     "datetime": "%Y-%m-%d %H:%M",
     "field": "ADMIT_TS"
    },
    "ATTEND_PROV_ID": "ATTEND_ID",
    "DEPT_ID": "CLINIC_CD",
    "DISCH_DT": {
     "datetime": "%Y-%m-%d %H:%M",
     "field": "DISCH_TS"
    },
    "PAT_ID": "PERSON_NO",
    "REASON_TEXT": "CHIEF_COMPLAINT",
    "STATUS": {
     "field": "STATUS",
     "map": {
      "CLOSED": "C",
      "OPEN": "A",
      "VOID": "X"
     }
    },
    "VISIT_ID": "VISIT_NO",
    "VISIT_TYPE": {
     "field": "VISIT_TYPE",
     "upper": true
    }
   },
   "file": "VISIT",
   "key": "VISIT_NO"
  },
  "MedicationRequest": {
   "fields": {
    "DOSE": "DOSE_TXT",
    "DRUG_NAME": "DRUG_DESC",
    "FORM_CODE": "DRUG_CD",
    "ORD_ID": "RX_NO",
    "PAT_ID": "PERSON_NO",
    "PROV_ID": "PRESCRIBER_ID",
    "SIG": "SIG_TXT",
    "START_DT": {
     "date": "%m/%d/%Y",
     "field": "ORDER_DT"
    },
    "STATUS": {
     "field": "RX_STATUS",
     "map": {
      "ACTIVE": "A",
      "COMPLETED": "C",
      "DISCONTINUED": "D",
      "HOLD": "H"
     }
    },
    "STOP_DT": {
     "date": "%m/%d/%Y",
     "field": "STOP_DT"
    },
    "VISIT_ID": "VISIT_NO"
   },
   "file": "RXORDER",
   "key": "RX_NO"
  },
  "Observation": [
   {
    "exclude": {
     "RESULT_STATUS": [
      "X"
     ]
    },
    "exclude_reason": {
     "X": "cancelled result (Ray Castillo, E000202)"
    },
    "fields": {
     "ABN_FLAG": "ABN",
     "ACCESSION": "ACCESSION",
     "COLLECT_DT": {
      "datetime": [
       "%d-%b-%y %H:%M",
       "%Y-%m-%d %H:%M"
      ],
      "field": "COLLECTED_TS"
     },
     "PAT_ID": "PERSON_NO",
     "REF_RANGE": "REF_RANGE",
     "RESULT_VAL": "RESULT",
     "TEST_CODE": "TEST_CD",
     "TEST_NAME": {
      "field": "TEST_CD",
      "lookup": {
       "file": "TESTDICT",
       "key": "TEST_CD",
       "value": "TEST_NAME"
      }
     },
     "UNITS": "UNITS",
     "VISIT_ID": "VISIT_NO",
     "_STATUS": "RESULT_STATUS"
    },
    "file": "LABRES",
    "key": "RES_NO",
    "kind": "lab"
   },
   {
    "fields": {
     "FIELD": {
      "field": "VS_TYPE",
      "map": {
       "BP": "BP",
       "HR": "PULSE",
       "HT": "HT",
       "RR": "RESP",
       "SPO2": "SPO2",
       "TEMP": "TEMP",
       "WT": "WT"
      }
     },
     "PAT_ID": "PERSON_NO",
     "TAKEN_DT": {
      "datetime": "%Y-%m-%d %H:%M",
      "field": "TAKEN_TS"
     },
     "VALUE": {
      "cases": [
       {
        "annotate": {
         "field": "valueQuantity.unit",
         "klass": "inferred",
         "note": "unit blank in source: migrated Sun Ridge history before 2016-03 read as US units (Gary Lindqvist E000164, hedged; 97-100 temperatures)",
         "weight": 1.0
        },
        "if": {
         "all": [
          {
           "blank": true,
           "value": "VS_UNIT"
          },
          {
           "in": [
            "WT",
            "TEMP",
            "HT"
           ],
           "value": "VS_TYPE"
          },
          {
           "in": [
            "SRC"
           ],
           "value": {
            "field": "VISIT_NO",
            "lookup": [
             {
              "file": "VISIT",
              "key": "VISIT_NO",
              "value": "CLINIC_CD"
             },
             {
              "file": "CLINIC",
              "key": "CLINIC_CD",
              "value": "CAMPUS_CD"
             }
            ]
           }
          },
          {
           "before": "201603010000",
           "value": {
            "datetime": "%Y-%m-%d %H:%M",
            "field": "TAKEN_TS"
           }
          }
         ]
        },
        "then": {
         "concat": [
          "VS_VALUE",
          {
           "const": " "
          },
          {
           "field": "VS_TYPE",
           "map": {
            "HT": "in",
            "TEMP": "F",
            "WT": "lb"
           }
          }
         ]
        }
       }
      ],
      "else": {
       "format": "{VS_VALUE} {VS_UNIT}"
      }
     },
     "VISIT_ID": "VISIT_NO"
    },
    "file": "VITALS",
    "key": "VS_NO",
    "kind": "vital"
   }
  ],
  "Organization": {
